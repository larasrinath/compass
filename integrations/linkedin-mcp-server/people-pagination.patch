 class TestSearchPeople:
+    @pytest.mark.parametrize("page", [2, 100, 1000])
+    async def test_explicit_page_preserves_filters_and_navigates_once(
+        self, mock_page, page
+    ):
+        extractor = LinkedInExtractor(mock_page)
+        with patch.object(
+            extractor,
+            "extract_page",
+            new_callable=AsyncMock,
+            return_value=extracted("Result"),
+        ) as fetch:
+            result = await extractor.search_people(
+                "platform engineer",
+                "Berlin",
+                network=["O"],
+                current_company="1115",
+                page=page,
+            )
+        query = parse_qs(urlparse(result["url"]).query)
+        assert query == {
+            "keywords": ["platform engineer"],
+            "location": ["Berlin"],
+            "network": ['["O"]'],
+            "currentCompany": ['["1115"]'],
+            "page": [str(page)],
+        }
+        assert result["page"] == page
+        fetch.assert_awaited_once_with(result["url"], section_name="search_results")
+
+    @pytest.mark.parametrize("page", [0, -1, 1001, True, "2", 1.5])
+    async def test_invalid_page_never_navigates(self, mock_page, page):
+        extractor = LinkedInExtractor(mock_page)
+        with patch.object(extractor, "extract_page", new_callable=AsyncMock) as fetch:
+            with pytest.raises(ValueError, match="page"):
+                await extractor.search_people("engineer", page=page)
+        fetch.assert_not_awaited()
+
