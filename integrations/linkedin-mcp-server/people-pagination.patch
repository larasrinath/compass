+@pytest.mark.parametrize("page", [0, 1001, True, "2", 1.5])
+async def test_search_people_mcp_rejects_invalid_page(page):
+    from fastmcp.exceptions import ValidationError
+    from linkedin_mcp_server.tools.person import register_person_tools
+
+    mcp = FastMCP("pagination")
+    register_person_tools(mcp)
+    with patch(
+        "linkedin_mcp_server.tools.person.get_ready_extractor", new_callable=AsyncMock
+    ) as ready:
+        with pytest.raises(ValidationError, match="page"):
+            await mcp.call_tool("search_people", {"keywords": "engineer", "page": page})
+        ready.assert_not_awaited()
+
+
+async def test_search_people_mcp_forwards_second_page():
+    from linkedin_mcp_server.tools.person import register_person_tools
+
+    mock = _make_mock_extractor({"page": 2, "sections": {"search_results": "Result"}})
+    mcp = FastMCP("pagination")
+    register_person_tools(mcp)
+    with patch(
+        "linkedin_mcp_server.tools.person.get_ready_extractor",
+        new_callable=AsyncMock,
+        return_value=mock,
+    ):
+        await mcp.call_tool(
+            "search_people",
+            {
+                "keywords": "engineer",
+                "page": 2,
+                "network": ["O"],
+                "location": "Berlin",
+                "current_company": "1115",
+            },
+        )
+    mock.search_people.assert_awaited_once_with(
+        "engineer", "Berlin", network=["O"], current_company="1115", page=2
+    )
