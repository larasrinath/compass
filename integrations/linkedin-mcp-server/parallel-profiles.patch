@@ -20,12 +20,12 @@ logger = logging.getLogger(__name__)
 
 
 class SequentialToolExecutionMiddleware(Middleware):
-    """Ensure only one tool call at a time drives the shared LinkedIn browser.
+    """Keep shared-tab actions exclusive and allow two isolated profile reads.
 
     Two layers, because one is not enough:
 
-    * an ``asyncio.Lock`` serializes calls inside this process, where several MCP
-      sessions can share one server;
+    * a condition grants either two isolated-profile slots or one exclusive
+      shared-tab slot inside this process;
     * the profile lease serializes calls across processes, where each MCP client
       instance spawns its own server against the same Chromium profile.
 
@@ -34,7 +34,44 @@ class SequentialToolExecutionMiddleware(Middleware):
     """
 
     def __init__(self) -> None:
-        self._lock = asyncio.Lock()
+        self._condition = asyncio.Condition()
+        self._readers = 0
+        self._exclusive = False
+        self._writers_waiting = 0
+
+    @asynccontextmanager
+    async def _slot(self, isolated_profile: bool):
+        # Only the isolated-tab tool may overlap. Give waiting shared-tab tools
+        # priority so an endless download stream cannot starve searches/login.
+        async with self._condition:
+            if isolated_profile:
+                await self._condition.wait_for(
+                    lambda: (
+                        not self._exclusive
+                        and not self._writers_waiting
+                        and self._readers < 2
+                    )
+                )
+                self._readers += 1
+            else:
+                self._writers_waiting += 1
+                try:
+                    await self._condition.wait_for(
+                        lambda: not self._exclusive and self._readers == 0
+                    )
+                    self._exclusive = True
+                finally:
+                    self._writers_waiting -= 1
+                    self._condition.notify_all()
+        try:
+            yield
+        finally:
+            async with self._condition:
+                if isolated_profile:
+                    self._readers -= 1
+                else:
+                    self._exclusive = False
+                self._condition.notify_all()
 
     async def _report_progress(
         self,
