 with configurable section selection.
 """
 
+import asyncio
 import logging
 from typing import Annotated, Any
 
@@ -28,6 +29,57 @@ def register_person_tools(
 ) -> None:
     """Register all person-related tools with the MCP server."""
 
+    @mcp.tool(
+        timeout=tool_timeout,
+        title="Get Person Profile in Isolated Tab",
+        annotations={"readOnlyHint": True, "openWorldHint": True},
+        tags={"person", "scraping"},
+    )
+    async def get_person_profile_parallel(
+        linkedin_username: str,
+        ctx: Context,
+        sections: str | None = None,
+        max_scrolls: Annotated[int, Field(ge=1, le=50)] | None = None,
+    ) -> dict[str, Any]:
+        """Read a profile in a private tab, allowing two concurrent profile reads.
+
+        Same result and section contract as get_person_profile. Middleware caps
+        concurrency at two and excludes all shared-tab tools until both finish.
+        Authentication failures are returned to the caller without closing the
+        browser underneath a sibling read. Reauthenticate after reads finish.
+        """
+        from linkedin_mcp_server.bootstrap import ensure_tool_ready_or_raise
+        from linkedin_mcp_server.config import get_config
+        from linkedin_mcp_server.core import await_deferring_cancels
+        from linkedin_mcp_server.drivers.browser import get_or_create_browser
+        from linkedin_mcp_server.scraping import LinkedInExtractor
+
+        page = None
+        try:
+            await ensure_tool_ready_or_raise("get_person_profile_parallel", ctx)
+            browser = await get_or_create_browser()
+            page, cancelled = await await_deferring_cancels(browser.context.new_page())
+            if cancelled:
+                raise asyncio.CancelledError
+            page.set_default_timeout(get_config().browser.default_timeout)
+            requested, unknown = parse_person_sections(sections)
+            result = await LinkedInExtractor(page).scrape_person(
+                linkedin_username,
+                requested,
+                callbacks=MCPContextProgressCallback(ctx),
+                max_scrolls=max_scrolls,
+            )
+            if unknown:
+                result["unknown_sections"] = unknown
+            return result
+        except Exception as error:
+            raise_tool_error(error, "get_person_profile_parallel")
+        finally:
+            if page is not None:
+                _, cancelled = await await_deferring_cancels(page.close())
+                if cancelled:
+                    raise asyncio.CancelledError
+
     @mcp.tool(
         timeout=tool_timeout,
         title="Get Person Profile",
