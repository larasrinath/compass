@@ -0,0 +1,180 @@
+import asyncio
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+from fastmcp import FastMCP
+from linkedin_mcp_server.sequential_tool_middleware import (
+    SequentialToolExecutionMiddleware,
+)
+from linkedin_mcp_server.tools.person import register_person_tools
+
+
+@pytest.fixture(autouse=True)
+def configured_timeout(monkeypatch):
+    from linkedin_mcp_server import config
+
+    settings = config.AppConfig()
+    settings.browser.default_timeout = 4321
+    monkeypatch.setattr(config, "get_config", lambda: settings)
+
+
+async def test_two_isolated_reads_overlap_but_shared_tools_are_exclusive():
+    gate = SequentialToolExecutionMiddleware()
+    release = asyncio.Event()
+    started = asyncio.Event()
+    active = []
+    order = []
+
+    async def read(number):
+        async with gate._slot(True):
+            active.append(number)
+            order.append(number)
+            assert len(active) <= 2
+            if len(active) == 2:
+                started.set()
+            await release.wait()
+            active.remove(number)
+
+    async def shared():
+        async with gate._slot(False):
+            assert active == []
+            order.append("search")
+
+    first = asyncio.create_task(read(1))
+    second = asyncio.create_task(read(2))
+    await asyncio.wait_for(started.wait(), 1)
+    writer = asyncio.create_task(shared())
+    await asyncio.sleep(0)
+    third = asyncio.create_task(read(3))
+    await asyncio.sleep(0)
+    assert order == [1, 2]
+    release.set()
+    await asyncio.gather(first, second, writer, third)
+    assert order == [1, 2, "search", 3]
+
+
+async def test_cancelled_waiter_releases_writer_priority():
+    gate = SequentialToolExecutionMiddleware()
+    async with gate._slot(True):
+
+        async def writer():
+            async with gate._slot(False):
+                pytest.fail("writer must wait")
+
+        task = asyncio.create_task(writer())
+        await asyncio.sleep(0)
+        task.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await task
+        async with asyncio.timeout(1):
+            async with gate._slot(True):
+                assert gate._readers == 2
+    assert gate._readers == 0
+
+
+@pytest.mark.parametrize("fail", [False, True])
+async def test_parallel_tool_uses_distinct_tabs_and_always_closes_them(
+    monkeypatch, fail
+):
+    from linkedin_mcp_server import bootstrap, scraping
+    from linkedin_mcp_server.drivers import browser as driver
+
+    pages = [MagicMock(close=AsyncMock()), MagicMock(close=AsyncMock())]
+    browser = MagicMock()
+    browser.context.new_page = AsyncMock(side_effect=pages)
+    monkeypatch.setattr(bootstrap, "ensure_tool_ready_or_raise", AsyncMock())
+    monkeypatch.setattr(
+        driver, "get_or_create_browser", AsyncMock(return_value=browser)
+    )
+    entered = []
+    both = asyncio.Event()
+
+    class Extractor:
+        def __init__(self, page):
+            self.page = page
+
+        async def scrape_person(self, username, sections, **kwargs):
+            entered.append(self.page)
+            if len(entered) == 2:
+                both.set()
+            await both.wait()
+            if fail:
+                raise ValueError("extraction failed")
+            return {"url": username, "sections": {"main_profile": username}}
+
+    monkeypatch.setattr(scraping, "LinkedInExtractor", Extractor)
+    mcp = FastMCP("test")
+    register_person_tools(mcp)
+    tool = await mcp.get_tool("get_person_profile_parallel")
+    results = await asyncio.gather(
+        tool.fn("one", MagicMock()), tool.fn("two", MagicMock()), return_exceptions=True
+    )
+    assert entered[0] is not entered[1]
+    from linkedin_mcp_server.config import get_config
+
+    for page in pages:
+        page.set_default_timeout.assert_called_once_with(
+            get_config().browser.default_timeout
+        )
+        page.close.assert_awaited_once()
+    if fail:
+        assert all(isinstance(result, ValueError) for result in results)
+    else:
+        assert [result["url"] for result in results] == ["one", "two"]
+
+
+async def test_middleware_admits_only_two_isolated_tool_calls():
+    mcp = FastMCP("parallel integration")
+    mcp.add_middleware(SequentialToolExecutionMiddleware())
+    active = 0
+    peak = 0
+
+    @mcp.tool
+    async def get_person_profile_parallel():
+        nonlocal active, peak
+        active += 1
+        peak = max(peak, active)
+        try:
+            await asyncio.sleep(0.02)
+            return {"ok": True}
+        finally:
+            active -= 1
+
+    await asyncio.gather(
+        *(mcp.call_tool("get_person_profile_parallel", {}) for _ in range(6))
+    )
+    assert peak == 2
+    assert active == 0
+
+
+async def test_cancelled_profile_closes_its_tab(monkeypatch):
+    from linkedin_mcp_server import bootstrap, scraping
+    from linkedin_mcp_server.drivers import browser as driver
+
+    page = MagicMock(close=AsyncMock())
+    browser = MagicMock()
+    browser.context.new_page = AsyncMock(return_value=page)
+    monkeypatch.setattr(bootstrap, "ensure_tool_ready_or_raise", AsyncMock())
+    monkeypatch.setattr(
+        driver, "get_or_create_browser", AsyncMock(return_value=browser)
+    )
+    started = asyncio.Event()
+
+    class Extractor:
+        def __init__(self, page):
+            pass
+
+        async def scrape_person(self, *args, **kwargs):
+            started.set()
+            await asyncio.Event().wait()
+
+    monkeypatch.setattr(scraping, "LinkedInExtractor", Extractor)
+    mcp = FastMCP("cancel-test")
+    register_person_tools(mcp)
+    tool = await mcp.get_tool("get_person_profile_parallel")
+    task = asyncio.create_task(tool.fn("one", MagicMock()))
+    await asyncio.wait_for(started.wait(), 1)
+    task.cancel()
+    with pytest.raises(asyncio.CancelledError):
+        await task
+    page.close.assert_awaited_once()
