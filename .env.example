# Dashboard process. Loopback hosts are enforced at startup.
HOST=127.0.0.1
PORT=8787
FRONTEND_HOST=127.0.0.1

# The operator starts linkedin-mcp-server separately in streamable HTTP mode.
MCP_URL=http://127.0.0.1:8000/mcp

# Defaults keep all profile data on this machine.
DB_PATH=~/.linkedin-dashboard/session.db
LLM_PROVIDER=null
SEND_ENABLED=false

