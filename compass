#!/bin/sh
# One entry point for macOS and Linux. Installs tools locally, never with sudo.
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
case "$(uname -s)" in Darwin|Linux) ;; *) echo 'Use macOS or Linux (Windows: WSL with a desktop browser).' >&2; exit 1;; esac
for tool in git curl; do
  command -v "$tool" >/dev/null 2>&1 || { echo "Compass needs $tool installed." >&2; exit 1; }
done
umask 077
mkdir -p .compass/tools
if command -v uv >/dev/null 2>&1; then
  COMPASS_UV=$(command -v uv)
elif [ -x "$PWD/.compass/tools/uv" ]; then
  COMPASS_UV="$PWD/.compass/tools/uv"
else
  echo 'Preparing Compass: installing uv locally…'
  installer=$(mktemp .compass/uv-install.XXXXXX)
  trap 'rm -f "$installer"' EXIT HUP INT TERM
  curl --proto '=https' --tlsv1.2 -fsSL https://astral.sh/uv/0.10.5/install.sh -o "$installer"
  UV_UNMANAGED_INSTALL="$PWD/.compass/tools" sh "$installer"
  rm -f "$installer"
  trap - EXIT HUP INT TERM
  COMPASS_UV="$PWD/.compass/tools/uv"
fi
export COMPASS_UV
UV_PROJECT_ENVIRONMENT="$PWD/.compass/dashboard-venv"
export UV_PROJECT_ENVIRONMENT
exec "$COMPASS_UV" run --frozen --no-dev --python 3.13 python -m linkedin_dashboard.launcher "$@"
